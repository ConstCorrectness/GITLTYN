---
import PaperLayout from '@/layouts/PaperLayout.astro';
import PaperContent, { frontmatter, getHeadings } from '@/content/paper.mdx';
import rawArtifact from '@/data/ablation_frontier.json';

const headings = getHeadings();
---

<PaperLayout
  title={frontmatter.title}
  subtitle={frontmatter.subtitle}
  authors={[
    {
      name: 'ConstCorrectness',
      url: 'https://github.com/ConstCorrectness',
      affiliation: 'github.com/ConstCorrectness',
    },
  ]}
  publishedDate={frontmatter.publishedDate}
  artifactTimestamp={rawArtifact.generated_at}
  abstract={frontmatter.abstract}
  headings={headings}
>
  <PaperContent />
</PaperLayout>
